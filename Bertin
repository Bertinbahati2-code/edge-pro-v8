    <button class="nav-item" data-page="pg-reports" onclick="App.nav('pg-reports',this);App.showReport()"><span class="icon">📋</span>Rapports</button>
    <button class="nav-item" data-page="pg-dashboard" onclick="App.nav('pg-dashboard',this);App.showDashboard()"><span class="icon">📊</span>Dashboard</button>
  </div>
</div>

