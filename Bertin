  // Nouveau : Recalcul du Home Advantage par ligue
  async recalculateHomeAdvantage() {
    const leagues = Object.keys(this._leaguesCache);
    for (const leagueKey of leagues) {
      if (leagueKey === 'Default') continue;
      const teamsInLeague = this._teamsCache.filter(t => {
        const resolved = resolveAlias(t.name);
        return TEAM_LEAGUE[t.name] === leagueKey || TEAM_LEAGUE[resolved] === leagueKey;
      });
      
      let homeWins = 0, totalMatches = 0;
      for (const team of teamsInLeague) {
        const homeMatches = (team.allMatches || []).filter(m => m.venue === 'home');
        for (const m of homeMatches) {
          const sc = (m.score || '').split('-');
          if (sc.length === 2) {
            const s = parseInt(sc[0]), c = parseInt(sc[1]);
            if (!isNaN(s) && !isNaN(c)) {
              totalMatches++;
              if (s > c) homeWins++;
            }
          }
        }
      }
      
      if (totalMatches > 10) {
        const homeWinRate = homeWins / totalMatches;
        // Formule : avantage terrain en points Elo ≈ 400 * log10(winRate / (1 - winRate))
        const expectedNeutral = 0.4; // Taux de victoire attendu sur terrain neutre
        const observedAdvantage = Math.max(0, homeWinRate - expectedNeutral);
        const eloAdvantage = Math.round(Math.min(100, Math.max(20, observedAdvantage * 200)));
        
        const lg = this._leaguesCache[leagueKey];
        if (lg) {
          lg.home_adv = eloAdvantage;
          lg.home_win_rate_calc = +(homeWinRate * 100).toFixed(1);
          lg.matches_used_for_adv = totalMatches;
          await DB.saveLeague(lg);
        }
      }
    }
    this._populateLeagueSelect();
  },

  // Nouveau : Analyse avec prise en compte de la date
  async analyzeMatch() {
    const btn = document.getElementById('btnAnalyze');
    if (!btn) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> Analyse temporelle...';

    try {
      const na = document.getElementById('teamA')?.value?.trim() || '';
      const nb = document.getElementById('teamB')?.value?.trim() || '';
      const matchDateStr = document.getElementById('matchDate')?.value || '';
      const allOdds = {
        c1: parseFloat(document.getElementById('c1')?.value) || 0,
        cX: parseFloat(document.getElementById('cX')?.value) || 0,
        c2: parseFloat(document.getElementById('c2')?.value) || 0,
        cbttsY: parseFloat(document.getElementById('cbttsY')?.value) || 0,
        cover: parseFloat(document.getElementById('cover')?.value) || 0
      };

      const tA = this._findTeam(na);
      const tB = this._findTeam(nb);
      const leagueKey = this.getSelectedLeague();
      const referenceDate = matchDateStr ? new Date(matchDateStr) : new Date();

      // Si on a une date et des équipes, recalculer les stats temporellement
      let statsA = tA?.stats || null;
      let statsB = tB?.stats || null;
      let homeStatsA = tA?.homeStats || null;
      let awayStatsB = tB?.awayStats || null;
      let last5A = tA?.last5 || [];
      let last5B = tB?.last5 || [];

      if (tA && (tA.allMatches?.length > 0) && matchDateStr) {
        const computedA = StatsCalculator.computeWeightedStats(tA.allMatches, referenceDate);
        if (computedA) {
          statsA = computedA.stats;
          homeStatsA = computedA.homeStats;
          last5A = computedA.last5;
        }
      }

      if (tB && (tB.allMatches?.length > 0) && matchDateStr) {
        const computedB = StatsCalculator.computeWeightedStats(tB.allMatches, referenceDate);
        if (computedB) {
          statsB = computedB.stats;
          awayStatsB = computedB.awayStats;
          last5B = computedB.last5;
        }
      }

      // Construire des objets temporaires pour l'analyse
      const teamAData = { name: clean(na), stats: statsA, homeStats: homeStatsA, last5: last5A, allMatches: tA?.allMatches || [] };
      const teamBData = { name: clean(nb), stats: statsB, awayStats: awayStatsB, last5: last5B, allMatches: tB?.allMatches || [] };

      const r = await ValueBetEngine.analyze(teamAData, teamBData, allOdds, this._settings, leagueKey, this._calibration);

      // H2H amélioré
      let h2hHTML = '';
      if (tA && tB) {
        const h2h = H2HEngine.getH2H(teamAData.name, teamBData.name, tA.allMatches || [], tB.allMatches || []);
        if (h2h && h2h.matches >= 2) {
          h2hHTML = `
            <div class="h2h-card">
              <h3 style="font-size:0.6rem">📜 H2H (${h2h.matches} confrontations)</h3>
              <div class="three-col" style="text-align:center">
                <div><span style="color:var(--green)">${h2h.wins} Vict.</span></div>
                <div><span style="color:var(--yellow)">${h2h.draws} Nuls</span></div>
                <div><span style="color:var(--red)">${h2h.losses} Déf.</span></div>
              </div>
              <div class="stat-row"><span>BTTS</span><span>${h2h.bttsRate}%</span></div>
              <div class="stat-row"><span>Over 2.5</span><span>${h2h.over25Rate}%</span></div>
              <div class="stat-row"><span>Moy. buts</span><span>${h2h.avgGoals}</span></div>
              <div class="stat-row"><span>Score fréquent</span><span>${h2h.mostFreqScore} (${h2h.mostFreqCount}x)</span></div>
              <div class="stat-row"><span>Forme récente</span><span>${h2h.recentForm} (${h2h.recentFormWins}/5)</span></div>
              ${h2h.lastMatch ? `<div class="stat-row"><span>Dernier match</span><span>${h2h.lastMatch.score} (${h2h.lastMatch.date || '?'})</span></div>` : ''}
              <div style="font-size:0.45rem;color:var(--sub);margin-top:4px">
                Derniers: ${h2h.last5.map(m => `${m.score}(${m.date?.slice(0,7)||'?'})`).join(' · ')}
              </div>
            </div>`;
        }
      }

      // Générer l'affichage (similaire à avant mais avec explications)
      const bp = r.bestPick;
      let explanationHTML = '';
      if (bp && bp.isValue) {
        const reasons = [];
        if (r.probs.p1 > 0.45 && bp.selection === '1') reasons.push('✅ Avantage domicile significatif');
        if (r.statsA?.home_xg > r.statsB?.away_xga && bp.selection === '1') reasons.push('✅ Meilleure attaque à domicile');
        if (r.statsB?.away_xga > r.statsA?.home_xg && bp.selection === '1') reasons.push('✅ Défense extérieure faible');
        if (r.modelAgreement > 0.7) reasons.push('✅ Forte concordance entre modèles');
        if (r.momentumA > 0.5 && bp.selection === '1') reasons.push('✅ Excellente forme récente');
        if (bp.edgePercent > 5) reasons.push('✅ Value positive significative');
        if (r.h2hAdvantage && bp.selection === '1') reasons.push('✅ Historique H2H favorable');
        
        if (reasons.length > 0) {
          explanationHTML = `<div class="explanation-box"><strong>🧠 Pourquoi ce pari ?</strong>${reasons.map(r => `<div class="reason">${r}</div>`).join('')}</div>`;
        }
      }

      // Score de cohérence entre modèles
      const coherenceScore = Math.round((1 - (Math.abs(r.dc_p1 - r.mc_p1) + Math.abs(r.dc_p1 - r.xg_p1) + Math.abs(r.mc_p1 - r.xg_p1)) / 3) * 100);

      // Le reste de l'affichage est similaire à l'original mais enrichi
      document.getElementById('analysisOutput').innerHTML = `
        ${r.hasData ? `<div class="data-ok">✅ Données: ${na} (${r.statsA.home_xg}xG dom.) · ${nb} (${r.statsB.away_xg}xG ext.)</div>` : `<div class="data-warn">⚠️ Données limitées</div>`}
        ${matchDateStr ? `<div style="font-size:0.5rem;color:var(--cyan)">📅 Analyse temporelle au ${matchDateStr} (seuls les matchs antérieurs sont utilisés)</div>` : ''}
        <!-- ... (reste de l'affichage similaire à l'original avec les nouvelles infos) ... -->
        ${explanationHTML}
        <div class="card"><h3>🔬 Cohérence des modèles</h3>
          <div class="stat-row"><span>Score de cohérence</span><span style="color:${coherenceScore>70?'var(--green)':coherenceScore>40?'var(--yellow)':'var(--red)'}">${coherenceScore}%</span></div>
          <div class="stat-row"><span>Accord Elo/DixonColes</span><span>${((1-Math.abs((r.elo_p1||0.33)-(r.dc_p1||0.33)))*100).toFixed(0)}%</span></div>
          <div class="stat-row"><span>Accord MonteCarlo/xG</span><span>${((1-Math.abs((r.mc_p1||0.33)-(r.xg_p1||0.33)))*100).toFixed(0)}%</span></div>
        </div>
      `;

      await DB.saveAnalysis({
        nameA: na, nameB: nb, league: leagueKey,
        probs: r.probs, confiance: r.confidence,
        pickMarket: bp?.market, pickSelection: bp?.selection,
        pickOdd: bp?.odd, pickEdge: bp?.edgePercent,
        mode: 'pro', edgeValue: bp?.edge, rating: bp?.rating,
        coherenceScore, matchDate: matchDateStr
      });
      this._calibration = {};
      await this._updateCounts();
    } catch (e) {
      console.error(e);
      showToast('❌ Erreur');
    } finally {
      btn.disabled = false;
      btn.textContent = '🚀 ANALYSE COMPLÈTE';
    }
  },

