    <div class="card">
      <h2>🗄️ Base (<span id="dbCount">0</span> éq. · <span id="dbMatchCount">0</span> matchs)</h2>
      <div class="row">
        <input id="dbSearch" placeholder="🔍 Rechercher..." oninput="App.searchDB()" style="flex:2">
        <button class="btn btn-secondary btn-small" onclick="App.searchDB()" style="flex:1">🔍</button>
      </div>
      <div id="dbResults" style="max-height:350px;overflow-y:auto;margin-top:6px"></div>
    </div>
  </div>

  <!-- PAGE 6: HISTORIQUE -->
  <div class="page" id="pg-history">
    <!-- ... contenu inchangé ... -->
  </div>

  <!-- PAGE 7: PARAMÈTRES -->
  <div class="page" id="pg-settings">
    <!-- ... contenu inchangé ... -->
  </div>

  <!-- PAGE 8: CHAMPIONNATS -->
  <div class="page" id="pg-leagues">
