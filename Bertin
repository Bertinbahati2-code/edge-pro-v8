
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
  <title>⚽ EDGE PRO AI v8.0 · PRO</title>
  <style>
    /* ... (styles inchangés) ... */
    :root {
      --bg:#0a0d14;--card:#141b2b;--border:#1f2937;--text:#f1f5f9;--sub:#94a3b8;
      --cyan:#06b6d4;--blue:#3b82f6;--green:#22c55e;--red:#ef4444;--yellow:#eab308;
      --purple:#8b5cf6;--orange:#f97316;--radius:14px;--safe:env(safe-area-inset-bottom,8px);
      --gold:#f59e0b;--premium:linear-gradient(135deg,#1a1a2e,#16213e);
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:flex;justify-content:center;min-height:100vh}
    .app{max-width:560px;width:100%;padding:10px;padding-bottom:100px}
    .header{background:var(--card);padding:12px 16px;border-radius:var(--radius);display:flex;justify-content:space-between;align-items:center;border:1px solid var(--border);margin-bottom:8px;position:sticky;top:8px;z-index:10;backdrop-filter:blur(10px)}
    .header h1{font-size:0.9rem;font-weight:800;background:linear-gradient(135deg,var(--cyan),var(--purple));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .version-badge{font-size:0.5rem;padding:3px 8px;border-radius:10px;background:linear-gradient(135deg,var(--purple),var(--cyan));color:#fff;font-weight:700}
    .card{background:var(--card);border-radius:var(--radius);padding:12px;margin-bottom:8px;border:1px solid var(--border)}
    .card.premium{background:var(--premium);border:2px solid var(--gold)}
    h2{font-size:0.78rem;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:6px}
    h3{font-size:0.7rem;font-weight:700;margin:8px 0 6px;color:var(--cyan)}
    .field{margin-bottom:6px;position:relative}
    .field label{display:block;font-size:0.5rem;text-transform:uppercase;color:var(--sub);font-weight:600;margin-bottom:2px}
    input,select,textarea{width:100%;padding:8px 10px;background:#1a2233;border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:14px;transition:border-color 0.2s}
    input:focus,select:focus,textarea:focus{outline:none;border-color:var(--cyan)}
    textarea{resize:vertical;min-height:60px;font-family:monospace;font-size:0.65rem}
    .btn{padding:10px 12px;border:none;border-radius:8px;font-weight:700;font-size:0.72rem;cursor:pointer;width:100%;margin:3px 0;color:#fff;transition:all 0.2s}
    .btn:disabled{opacity:0.5;cursor:not-allowed}
    .btn-accent{background:linear-gradient(135deg,var(--yellow),var(--orange));color:#000}
    .btn-accent:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 4px 12px rgba(234,179,8,.3)}
    .btn-success{background:linear-gradient(135deg,var(--green),#10b981)}
    .btn-danger{background:linear-gradient(135deg,var(--red),#dc2626)}
    .btn-secondary{background:#1a2233;border:1px solid var(--border)}
    .btn-premium{background:linear-gradient(135deg,var(--gold),#d97706);color:#000}
    .btn-small{padding:5px 8px;font-size:0.6rem;width:auto}
    .row{display:flex;gap:5px;flex-wrap:wrap}
    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:5px}
    .three-col{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px}
    .four-col{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:4px}
    .badge{display:inline-block;padding:2px 6px;border-radius:10px;font-size:0.5rem;font-weight:700}
    .badge-green{background:rgba(34,197,94,.2);color:var(--green)}
    .badge-blue{background:rgba(59,130,246,.2);color:var(--blue)}
    .badge-yellow{background:rgba(234,179,8,.2);color:var(--yellow)}
    .badge-red{background:rgba(239,68,68,.2);color:var(--red)}
    .badge-purple{background:rgba(139,92,246,.2);color:var(--purple)}
    .badge-gold{background:rgba(245,158,11,.2);color:var(--gold)}
    .nav-bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);max-width:560px;width:100%;background:var(--card);border-top:1px solid var(--border);display:flex;justify-content:space-around;padding:4px 0 var(--safe);z-index:20;overflow-x:auto;gap:2px}
    .nav-item{display:flex;flex-direction:column;align-items:center;font-size:0.4rem;color:var(--sub);cursor:pointer;padding:3px 2px;border:none;background:transparent;min-width:44px;transition:color 0.2s}
    .nav-item .icon{font-size:0.9rem}
    .nav-item.active{color:var(--cyan)}
    .page{display:none}
    .page.active{display:block}
    .suggestions{background:#1a2233;border-radius:8px;margin-top:2px;max-height:160px;overflow-y:auto;display:none;border:1px solid var(--border);position:absolute;z-index:5;width:100%}
    .suggestions div{padding:8px 10px;cursor:pointer;font-size:0.7rem;border-bottom:1px solid var(--border)}
    .suggestions div:hover{background:var(--border)}
    .result-box{background:#1a2233;border-radius:8px;padding:10px;margin:5px 0}
    .stat-row{display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid rgba(31,41,55,.5);font-size:0.65rem}
    .stat-row:last-child{border-bottom:none}
    .stat-value{font-weight:700}
    .confidence-bar{height:6px;background:#1f2937;border-radius:3px;overflow:hidden;margin:4px 0}
    .confidence-fill{height:100%;border-radius:3px;transition:width 0.5s}
    .confidence-fill.high{background:linear-gradient(90deg,var(--green),#10b981)}
    .confidence-fill.medium{background:linear-gradient(90deg,var(--yellow),var(--orange))}
    .confidence-fill.low{background:linear-gradient(90deg,var(--orange),var(--red))}
    .final-pick-box{background:linear-gradient(135deg,#0a0f1a,#111827);border:3px solid var(--green);border-radius:var(--radius);padding:16px;margin:10px 0;text-align:center;animation:glowPick 2s infinite}
    .final-pick-box.hot{border-color:var(--gold);animation:glowHot 1.5s infinite}
    .final-pick-box.no-value{border-color:var(--red);animation:none;opacity:0.8}
    @keyframes glowPick{0%,100%{box-shadow:0 0 12px rgba(34,197,94,.4)}50%{box-shadow:0 0 24px rgba(34,197,94,.8)}}
    @keyframes glowHot{0%,100%{box-shadow:0 0 16px rgba(245,158,11,.5)}50%{box-shadow:0 0 32px rgba(245,158,11,.9)}}
    .pick-label{font-size:0.5rem;text-transform:uppercase;letter-spacing:2px;color:var(--sub)}
    .pick-market{font-size:1.1rem;font-weight:900;margin:3px 0}
    .pick-selection{font-size:1.6rem;font-weight:900;margin:4px 0}
    .pick-odd{font-size:0.9rem;color:var(--yellow)}
    .pick-edge{font-size:0.6rem;color:var(--green);margin-top:3px}
    .compare-table{width:100%;border-collapse:collapse;font-size:0.5rem;margin:6px 0}
    .compare-table th{background:#0d1117;padding:5px 3px;text-align:center;color:var(--sub);font-size:0.45rem;text-transform:uppercase}
    .compare-table td{padding:5px 3px;text-align:center;border-bottom:1px solid var(--border)}
    .compare-table .value-row{background:rgba(34,197,94,.1)}
    .import-summary{background:#0d1117;border-radius:8px;padding:10px;margin:6px 0;border:1px solid var(--border);max-height:300px;overflow-y:auto}
    .import-summary .line{padding:3px 0;font-size:0.65rem;display:flex;justify-content:space-between}
    .spinner{display:inline-block;width:16px;height:16px;border:2px solid #1f2937;border-top-color:var(--cyan);border-radius:50%;animation:spin .6s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--card);color:var(--text);padding:8px 16px;border-radius:16px;font-size:0.7rem;z-index:30;border:1px solid var(--border);animation:fadeInOut 2.5s}
    @keyframes fadeInOut{0%{opacity:0;transform:translateX(-50%) translateY(8px)}10%{opacity:1}90%{opacity:1}100%{opacity:0}}
    .section-title{font-size:0.55rem;text-transform:uppercase;letter-spacing:1px;color:var(--cyan);margin:8px 0 4px;padding-bottom:2px;border-bottom:1px solid var(--border)}
    .kelly-box{background:rgba(139,92,246,.1);border:1px solid var(--purple);border-radius:6px;padding:6px;margin:4px 0;font-size:0.6rem}
    .rating{color:var(--gold);letter-spacing:2px}
    .slider{width:100%;accent-color:var(--cyan)}
    .chart-bar{height:20px;background:linear-gradient(90deg,var(--cyan),var(--purple));border-radius:4px;transition:width 0.5s;margin:2px 0}
    .mini-chart{display:flex;align-items:flex-end;gap:2px;height:40px}
    .mini-chart div{flex:1;background:var(--cyan);border-radius:2px 2px 0 0;min-width:3px}
    .tag{display:inline-block;padding:2px 6px;border-radius:4px;font-size:0.45rem;margin:1px;background:rgba(59,130,246,.2);color:var(--blue)}
    .h2h-card{background:rgba(139,92,246,.05);border:1px solid rgba(139,92,246,.3);border-radius:8px;padding:8px;margin:6px 0}
    .explanation-box{background:rgba(34,197,94,.05);border:1px solid rgba(34,197,94,.3);border-radius:8px;padding:8px;margin:8px 0;font-size:0.55rem}
    .explanation-box .reason{padding:2px 0;color:var(--green)}
    .error-report{background:rgba(239,68,68,.05);border:1px solid rgba(239,68,68,.3);border-radius:8px;padding:6px;margin:4px 0;font-size:0.5rem;max-height:150px;overflow-y:auto}
    .import-log{background:#0d1117;border-radius:8px;padding:8px;margin:4px 0;font-size:0.5rem;max-height:200px;overflow-y:auto}
  </style>
</head>
<body>
<div class="app">
  <div class="header">
    <div style="display:flex;align-items:center;gap:6px">
      <h1>⚽ EDGE PRO AI</h1>
      <span class="version-badge">v8.0</span>
    </div>
    <div style="font-size:0.45rem;color:var(--sub);text-align:right">
      <div>🗄️<span id="hdrDB">0</span> · ⚽<span id="hdrMatches">0</span></div>
    </div>
  </div>

  <!-- PAGES (identiques, non modifiées pour la longueur, sauf la page Base qui aura un affichage amélioré) -->
  <!-- PAGE 1: ANALYSE -->
  <div class="page active" id="pg-analyse">
    <div class="card">
      <h2>🏴 Analyse de match</h2>
      <div class="row">
        <div class="field" style="position:relative;flex:1">
          <label>Domicile</label>
          <input id="teamA" placeholder="Liverpool" oninput="App.suggest('teamA')" autocomplete="off">
          <div class="suggestions" id="suggestA"></div>
        </div>
        <div class="field" style="position:relative;flex:1">
          <label>Extérieur</label>
          <input id="teamB" placeholder="Arsenal" oninput="App.suggest('teamB')" autocomplete="off">
          <div class="suggestions" id="suggestB"></div>
        </div>
      </div>
      <div class="field"><label>🏆 Championnat</label><select id="leagueSelect"></select></div>
      <!-- Nouveau champ Date pour l'analyse -->
      <div class="field"><label>📅 Date du match (optionnel, pour analyse temporelle)</label><input id="matchDate" type="date"></div>
      <div class="section-title">📊 Cotes</div>
      <div class="three-col">
        <div class="field"><label>1</label><input id="c1" type="number" step="0.01" placeholder="2.50"></div>
        <div class="field"><label>X</label><input id="cX" type="number" step="0.01" placeholder="3.40"></div>
        <div class="field"><label>2</label><input id="c2" type="number" step="0.01" placeholder="2.80"></div>
      </div>
      <div class="two-col">
        <div class="field"><label>BTTS OUI</label><input id="cbttsY" type="number" step="0.01" placeholder="1.80"></div>
        <div class="field"><label>Over 2.5</label><input id="cover" type="number" step="0.01" placeholder="1.90"></div>
      </div>
      <button class="btn btn-accent" id="btnAnalyze" onclick="App.analyzeMatch()">🚀 ANALYSE COMPLÈTE</button>
    </div>
    <div id="analysisOutput"></div>
  </div>

  <!-- PAGE 2: CALIBRATION MATCH -->
  <div class="page" id="pg-calibration-match">
    <div class="card">
      <h2>🧠 Calibration Match</h2>
      <!-- ... contenu inchangé ... -->
      <div class="two-col"><div class="field"><label>Équipe Domicile</label><input id="calTeamA" placeholder="Sélectionnée auto"></div><div class="field"><label>Équipe Extérieur</label><input id="calTeamB" placeholder="Sélectionnée auto"></div></div>
      <div class="section-title">🏥 Domicile</div>
      <div class="two-col"><div class="field"><label>Blessures</label><select id="calInjA"><option value="0">Aucun absent</option><option value="1">1 titulaire</option><option value="2">2 titulaires</option><option value="3">Plusieurs titulaires</option></select></div><div class="field"><label>Suspensions</label><select id="calSuspA"><option value="0">Non</option><option value="1">Oui</option></select></div></div>
      <div class="two-col"><div class="field"><label>Fatigue (0-100)</label><input id="calFatigueA" type="range" min="0" max="100" value="20" class="slider"><span style="font-size:0.5rem" id="calFatigueAVal">20</span></div><div class="field"><label>Rotation (0-100)</label><input id="calRotA" type="range" min="0" max="100" value="10" class="slider"><span style="font-size:0.5rem" id="calRotAVal">10</span></div></div>
      <div class="two-col"><div class="field"><label>Motivation</label><select id="calMotA"><option value="1">Très faible</option><option value="2">Faible</option><option value="3" selected>Normale</option><option value="4">Forte</option><option value="5">Très forte</option></select></div><div class="field"><label>Importance</label><select id="calImpA"><option value="1">Amical</option><option value="2" selected>Championnat</option><option value="3">Coupe</option><option value="4">Qualification</option><option value="5">Finale</option></select></div></div>
      <div class="section-title">🏥 Extérieur</div>
      <div class="two-col"><div class="field"><label>Blessures</label><select id="calInjB"><option value="0">Aucun absent</option><option value="1">1 titulaire</option><option value="2">2 titulaires</option><option value="3">Plusieurs titulaires</option></select></div><div class="field"><label>Suspensions</label><select id="calSuspB"><option value="0">Non</option><option value="1">Oui</option></select></div></div>
      <div class="two-col"><div class="field"><label>Fatigue (0-100)</label><input id="calFatigueB" type="range" min="0" max="100" value="20" class="slider"><span style="font-size:0.5rem" id="calFatigueBVal">20</span></div><div class="field"><label>Rotation (0-100)</label><input id="calRotB" type="range" min="0" max="100" value="10" class="slider"><span style="font-size:0.5rem" id="calRotBVal">10</span></div></div>
      <div class="two-col"><div class="field"><label>Motivation</label><select id="calMotB"><option value="1">Très faible</option><option value="2">Faible</option><option value="3" selected>Normale</option><option value="4">Forte</option><option value="5">Très forte</option></select></div><div class="field"><label>Importance</label><select id="calImpB"><option value="1">Amical</option><option value="2" selected>Championnat</option><option value="3">Coupe</option><option value="4">Qualification</option><option value="5">Finale</option></select></div></div>
      <div class="section-title">🌤️ Conditions</div>
      <div class="two-col"><div class="field"><label>Météo</label><select id="calWeather"><option value="0">Soleil</option><option value="1">Nuages</option><option value="2">Pluie</option><option value="3">Neige</option><option value="4">Vent fort</option></select></div><div class="field"><label>Pelouse</label><select id="calPitch"><option value="0">Excellent</option><option value="1">Bon</option><option value="2">Moyen</option><option value="3">Mauvais</option></select></div></div>
      <div class="two-col"><div class="field"><label>Jours repos Domicile</label><input id="calRestA" type="number" min="0" max="10" value="4"></div><div class="field"><label>Jours repos Extérieur</label><input id="calRestB" type="number" min="0" max="10" value="4"></div></div>
      <button class="btn btn-premium" onclick="App.applyCalibration()">🧠 APPLIQUER CALIBRATION</button>
    </div>
  </div>

