      <h2>📂 Import</h2>
      <input type="file" id="fileInput" style="display:none" accept=".csv,.txt,.tsv,.json,.xlsx" onchange="App.importMassive(event)" multiple>
      <button class="btn btn-accent" onclick="document.getElementById('fileInput').click()">📥 IMPORTER CSV/JSON</button>
