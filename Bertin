  <!-- NAVIGATION -->
  <div class="nav-bar">
    <!-- ... contenu inchangé ... -->
    <button class="nav-item active" data-page="pg-analyse" onclick="App.nav('pg-analyse',this)"><span class="icon">🏠</span>Analyse</button>
    <button class="nav-item" data-page="pg-calibration-match" onclick="App.nav('pg-calibration-match',this)"><span class="icon">🧠</span>Cal. Match</button>
    <button class="nav-item" data-page="pg-calibration-team" onclick="App.nav('pg-calibration-team',this)"><span class="icon">⚙</span>Cal. Équipe</button>
    <button class="nav-item" data-page="pg-stats" onclick="App.nav('pg-stats',this)"><span class="icon">📊</span>Stats</button>
    <button class="nav-item" data-page="pg-base" onclick="App.nav('pg-base',this)"><span class="icon">🗄️</span>Base</button>
    <button class="nav-item" data-page="pg-history" onclick="App.nav('pg-history',this);App.showHistory()"><span class="icon">📈</span>Historique</button>
    <button class="nav-item" data-page="pg-settings" onclick="App.nav('pg-settings',this);App.loadSettings()"><span class="icon">⚙️</span>Réglages</button>
