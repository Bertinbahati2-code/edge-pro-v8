// ==================== STATS CALCULATOR AMÉLIORÉ ====================
const StatsCalculator={
  computeFromMatches(m){/* ... (inchangé, mais sera appelé avec des matchs filtrés temporellement) ... */},
  _streak(rf,type){/* ... */},
  sampleSizeFactor(n){/* ... */},
  momentumScore(l5){/* ... */},
  dataReliability(n,recency){/* ... */},

  // Nouveau : Recalcul complet avec pondération temporelle
  computeWeightedStats(matches, referenceDate) {
    if (!matches?.length) return null;
    const refDate = referenceDate ? new Date(referenceDate) : new Date();
    
    // Trier par date
    const sorted = [...matches].sort((a, b) => new Date(a.date || '1970-01-01') - new Date(b.date || '1970-01-01'));
    
    // Filtrer matchs avant la date de référence
    const beforeRef = sorted.filter(m => {
      const mDate = new Date(m.date || '1970-01-01');
      return mDate <= refDate;
    });
    if (beforeRef.length === 0 && sorted.length > 0) return this.computeFromMatches(sorted);

    const targetMatches = beforeRef.length > 0 ? beforeRef : sorted;
    const last5 = targetMatches.slice(-5);
    const last10 = targetMatches.slice(-10);
    const last20 = targetMatches.slice(-20);

    // Périodes
    const oneYearAgo = new Date(refDate);
    oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
    const last365 = targetMatches.filter(m => new Date(m.date || '1970-01-01') >= oneYearAgo);
    
    // Saison en cours (août à mai)
    const currentYear = refDate.getFullYear();
    const seasonStart = new Date(currentYear - (refDate.getMonth() < 7 ? 1 : 0), 7, 1); // 1er août
    const currentSeason = targetMatches.filter(m => {
      const d = new Date(m.date || '1970-01-01');
      return d >= seasonStart && d <= refDate;
    });

    // Calcul des stats avec pondération
    const weightedStats = this._calculateWeighted(targetMatches, refDate);
    
    return {
      stats: weightedStats.global,
      homeStats: this._computeVenueStats(targetMatches, 'home'),
      awayStats: this._computeVenueStats(targetMatches, 'away'),
      last5: last5.map(m => m.score),
      last10: last10.map(m => m.score),
      last20: last20.map(m => m.score),
      last5Matches: last5,
      last10Matches: last10,
      last20Matches: last20,
      seasonStats: this._calculateWeighted(currentSeason.length > 0 ? currentSeason : targetMatches.slice(-38), refDate).global,
      last365Stats: this._calculateWeighted(last365.length > 0 ? last365 : targetMatches.slice(-50), refDate).global,
      allMatches: targetMatches.slice(0, 10000), // Limite à 10000 matchs
      totalMatches: targetMatches.length,
      seasonMatches: currentSeason.length,
      last365Matches: last365.length
    };
  },

  _calculateWeighted(matches, refDate) {
    if (!matches.length) return { global: {} };
    const ref = refDate || new Date();
    const now = ref.getTime();
    const sorted = [...matches].sort((a, b) => new Date(b.date || '1970-01-01') - new Date(a.date || '1970-01-01'));
    
    let wW = 0, wD = 0, wL = 0, wBT = 0, wO25 = 0, totalWeight = 0;
    let goalsFor = 0, goalsAgainst = 0;
    const formResults = [];

    sorted.forEach((m, index) => {
      const mDate = new Date(m.date || '1970-01-01').getTime();
      const ageInDays = Math.max(0, (now - mDate) / (1000 * 60 * 60 * 24));
      
      // Pondération temporelle
      let weight = 1;
      if (index < 5) weight = 1.0;        // 5 derniers : 100%
      else if (index < 10) weight = 0.8;  // 10 derniers : 80%
      else if (index < 20) weight = 0.6;  // 20 derniers : 60%
      else if (ageInDays < 365) weight = 0.4; // Saison précédente : 40%
      else weight = 0.2;                  // Plus ancien : 20%

      const sc = typeof m === 'string' ? m : (m.score || '');
      const p = sc.split('-');
      if (p.length !== 2) return;
      const s = parseInt(p[0]), c = parseInt(p[1]);
      if (isNaN(s) || isNaN(c)) return;

      totalWeight += weight;
      if (s > c) wW += weight;
      else if (s === c) wD += weight;
      else wL += weight;
      if (s > 0 && c > 0) wBT += weight;
      if (s + c > 2.5) wO25 += weight;
      goalsFor += s * weight;
      goalsAgainst += c * weight;
      formResults.push({ score: sc, result: s > c ? 'W' : s === c ? 'D' : 'L', date: m.date, weight });
    });

    const t = totalWeight || 1;
    const ppg = (wW * 3 + wD) / t;
    const avgGF = goalsFor / t;
    const avgGA = goalsAgainst / t;
    
    // Elo simplifié avec pondération
    const eloBase = 1500;
    const eloChange = (wW - wL) * 15;
    const elo = Math.round(eloBase + eloChange);

    // Forme récente
    const recentForm = formResults.slice(0, 20).map(r => r.result);
    const form5 = recentForm.slice(0, 5).join('');
    const form10 = recentForm.slice(0, 10).join('');

    return {
      global: {
        xg: +avgGF.toFixed(2),
        xga: +avgGA.toFixed(2),
        ppg: +ppg.toFixed(2),
        btts: +((wBT / t) * 100).toFixed(1),
        over25: +((wO25 / t) * 100).toFixed(1),
        elo: elo,
        form: form5,
        form10: form10,
        form20: recentForm.slice(0, 20).join(''),
        wins: Math.round(wW),
        draws: Math.round(wD),
        losses: Math.round(wL),
        cleanSheets: formResults.filter(r => r.score.split('-')[1] === '0').length,
        failedToScore: formResults.filter(r => r.score.split('-')[0] === '0').length,
        streakW: this._streak(recentForm, 'W'),
        streakU: this._streak(recentForm.filter(x => x !== 'L'), 'W'),
        totalMatches: matches.length,
        avgGoals: +avgGF.toFixed(2),
        avgConceded: +avgGA.toFixed(2),
        momentum: this._calculateMomentum(formResults.slice(0, 10))
      }
    };
  },

  _calculateMomentum(recentMatches) {
    if (!recentMatches?.length) return 0.33;
    let ms = 0;
    const weights = [0.35, 0.25, 0.2, 0.12, 0.08];
    recentMatches.slice(0, 5).forEach((r, i) => {
      const sc = r.score.split('-');
      const s = parseInt(sc[0]), c = parseInt(sc[1]);
      if (!isNaN(s) && !isNaN(c)) {
        ms += ((s > c ? 1 : s === c ? 0.5 : 0) * weights[i]) + ((s - c) * 0.02);
      }
    });
    return Math.min(0.7, Math.max(0.15, ms));
  },

  _computeVenueStats(matches, venue) {
    const venueMatches = matches.filter(m => m.venue === venue);
    if (venueMatches.length < 2) {
      return venue === 'home' ? { xg: 1.5, xga: 1.2, ppg: 1.5, btts: 55, over25: 52, matches: 0 }
        : { xg: 1.2, xga: 1.5, ppg: 1.0, btts: 55, over25: 52, matches: 0 };
    }
    const stats = this._calculateWeighted(venueMatches, new Date());
    return {
      xg: stats.global.xg,
      xga: stats.global.xga,
      ppg: stats.global.ppg,
      btts: stats.global.btts,
      over25: stats.global.over25,
      matches: venueMatches.length,
      wins: stats.global.wins,
      draws: stats.global.draws,
      losses: stats.global.losses
    };
  }
};

// ==================== H2H ENGINE AMÉLIORÉ ====================
const H2HEngine={
  getH2H(teamA, teamB, allMatchesA, allMatchesB) {
    const h2hMatches = [];
    const seen = new Set();

    // Chercher les matchs où A joue contre B
    (allMatchesA || []).forEach(m => {
      if (clean(m.opponent || '') === clean(teamB || '')) {
        const key = `${m.date}_${m.score}_${m.venue}`;
        if (!seen.has(key)) {
          seen.add(key);
          h2hMatches.push({ ...m, perspective: 'A' });
        }
      }
    });

    // Chercher les matchs où B joue contre A (complémentaire)
    (allMatchesB || []).forEach(m => {
      if (clean(m.opponent || '') === clean(teamA || '')) {
        const key = `${m.date}_${m.score}_${m.venue}`;
        if (!seen.has(key)) {
          seen.add(key);
          // Inverser la perspective si nécessaire
          const sc = (m.score || '').split('-');
          if (sc.length === 2) {
            const invertedScore = `${sc[1]}-${sc[0]}`;
            h2hMatches.push({ ...m, score: invertedScore, perspective: 'B', venue: m.venue === 'home' ? 'away' : 'home' });
          }
        }
      }
    });

    if (h2hMatches.length < 2) return null;

    // Trier par date
    const sorted = h2hMatches.sort((a, b) => new Date(a.date || '1970-01-01') - new Date(b.date || '1970-01-01'));
    
    let wA = 0, d = 0, wB = 0, bt = 0, o25 = 0, totalGoals = 0;
    const scoreFrequency = {};
    
    sorted.forEach(m => {
      const sc = (m.score || '').split('-');
      const s = parseInt(sc[0]), c = parseInt(sc[1]);
      if (isNaN(s) || isNaN(c)) return;
      
      totalGoals += s + c;
      if (s > c) m.perspective === 'A' ? wA++ : wB++;
      else if (s === c) d++;
      else m.perspective === 'A' ? wB++ : wA++;
      if (s > 0 && c > 0) bt++;
      if (s + c > 2.5) o25++;
      scoreFrequency[m.score] = (scoreFrequency[m.score] || 0) + 1;
    });

    const t = sorted.length;
    const last20 = sorted.slice(-20);
    const last5 = sorted.slice(-5);
    
    const mostFreqScore = Object.entries(scoreFrequency).sort((a, b) => b[1] - a[1])[0];
    
    // Forme H2H récente
    const recentForm = last5.map(m => {
      const sc = (m.score || '').split('-');
      const s = parseInt(sc[0]), c = parseInt(sc[1]);
      return s > c ? (m.perspective === 'A' ? 'W' : 'L') : s === c ? 'D' : (m.perspective === 'A' ? 'L' : 'W');
    });

    return {
      matches: t,
      wins: wA,
      draws: d,
      losses: wB,
      winRate: +(wA / t).toFixed(2),
      bttsRate: +((bt / t) * 100).toFixed(1),
      over25Rate: +((o25 / t) * 100).toFixed(1),
      avgGoals: +(totalGoals / t).toFixed(2),
      mostFreqScore: mostFreqScore ? mostFreqScore[0] : '?',
      mostFreqCount: mostFreqScore ? mostFreqScore[1] : 0,
      lastMatch: sorted[sorted.length - 1],
      recentForm: recentForm.join(''),
      recentFormWins: recentForm.filter(r => r === 'W').length,
      last5: last5.map(m => ({ score: m.score, date: m.date, venue: m.venue })),
      last20: last20.map(m => ({ score: m.score, date: m.date, venue: m.venue })),
      allMatches: sorted
    };
  },

  getH2HProbs(teamA, teamB, cacheA, cacheB) {
    const h2h = this.getH2H(teamA, teamB, cacheA, cacheB);
    if (!h2h || h2h.matches < 3) return null;
    return {
      p1: h2h.winRate,
      pX: +(h2h.matches - h2h.wins - h2h.losses) / h2h.matches,
      p2: +(h2h.losses / h2h.matches),
      btts: h2h.bttsRate / 100,
      over25: h2h.over25Rate / 100
    };
  }
};

// ==================== DATA MANAGER AMÉLIORÉ ====================
const DataManager = {
  async smartImport(file) {
    const st = document.getElementById('importStatus');
    const startTime = Date.now();
    const errors = [];
    let added = 0, updated = 0, newMatches = 0, skipped = 0;

    try {
      // Sauvegarde automatique
      await App.autoBackup();

      const txt = await file.text();
      const lines = txt.split(/\r?\n/).filter(l => l.trim());
      if (lines.length < 2) {
        st.innerHTML = '❌ Fichier vide ou invalide';
        return { added: 0, updated: 0, newMatches: 0, errors: ['Fichier vide'] };
      }

      // Détection du séparateur
      const seps = [',', ';', '\t', '|'];
      let bestSep = ',', maxFields = 0;
      for (const s of seps) {
        const fc = lines[0].split(s).length;
        if (fc > maxFields) { maxFields = fc; bestSep = s; }
      }

      const headers = lines[0].split(bestSep).map(h => h.trim().replace(/^["']|["']$/g, ''));
      const colMap = this._detectColumnsAdvanced(headers);
      
      if (colMap.dateCol === -1) {
        errors.push('Colonne Date non détectée. Utilisation de dates factices.');
      }

      // Traitement des lignes
      const allRawMatches = [];
      const invalidScores = new Set(['?-?', 'null-null', 'undefined-undefined', '-', ' - ']);
      
      for (let i = 1; i < lines.length; i++) {
        if (!lines[i].trim()) continue;
        const values = lines[i].split(bestSep).map(x => x.trim().replace(/^["']|["']$/g, ''));
        
        const rawHome = values[colMap.homeTeam] || '';
        const rawAway = values[colMap.awayTeam] || '';
        const rawScore = values[colMap.scoreCol] !== undefined ? values[colMap.scoreCol] : 
                         `${values[colMap.homeGoals] || ''}-${values[colMap.awayGoals] || ''}`;
        const rawDate = colMap.dateCol !== -1 ? values[colMap.dateCol] : '';

        // Validation
        if (!rawHome || !rawAway) { skipped++; continue; }
        
        const scoreParts = rawScore.split('-');
        if (scoreParts.length !== 2) { skipped++; errors.push(`Ligne ${i}: score invalide "${rawScore}"`); continue; }
        
        const hg = parseInt(scoreParts[0]), ag = parseInt(scoreParts[1]);
        if (isNaN(hg) || isNaN(ag)) { skipped++; errors.push(`Ligne ${i}: buts non numériques`); continue; }
        if (hg < 0 || ag < 0 || hg > 20 || ag > 20) { skipped++; errors.push(`Ligne ${i}: score impossible ${hg}-${ag}`); continue; }
        if (invalidScores.has(rawScore.toLowerCase())) { skipped++; continue; }

        const ht = resolveAlias(rawHome);
        const at = resolveAlias(rawAway);
        if (!ht || !at) { skipped++; errors.push(`Ligne ${i}: équipe non résolue "${rawHome}" ou "${rawAway}"`); continue; }
        if (clean(ht) === clean(at)) { skipped++; errors.push(`Ligne ${i}: équipes identiques`); continue; }

        // Parsing date
        const parsedDate = DateParser.parse(rawDate);
        if (colMap.dateCol !== -1 && !parsedDate) {
          errors.push(`Ligne ${i}: date invalide "${rawDate}"`);
        }

        allRawMatches.push({
          homeTeam: ht,
          awayTeam: at,
          homeTeamRaw: rawHome,
          awayTeamRaw: rawAway,
          score: `${hg}-${ag}`,
          homeGoals: hg,
          awayGoals: ag,
          date: parsedDate || `1970-01-${String(i).padStart(2, '0')}`,
          dateRaw: rawDate,
          venue: 'home'
        });
      }

      // Détection de doublons
      const uniqueMatches = [];
      const seen = new Set();
      let duplicatesRemoved = 0;
      for (const m of allRawMatches) {
        const key = `${clean(m.homeTeam)}_${clean(m.awayTeam)}_${m.date}_${m.score}`;
        if (!seen.has(key)) {
          seen.add(key);
          uniqueMatches.push(m);
        } else {
          duplicatesRemoved++;
        }
      }
      if (duplicatesRemoved > 0) errors.push(`${duplicatesRemoved} doublons ignorés`);

      // Tri chronologique
      uniqueMatches.sort((a, b) => new Date(a.date) - new Date(b.date));

      // Regroupement par équipe
      const teamData = new Map();
      for (const m of uniqueMatches) {
        if (!teamData.has(m.homeTeam)) teamData.set(m.homeTeam, []);
        if (!teamData.has(m.awayTeam)) teamData.set(m.awayTeam, []);
        teamData.get(m.homeTeam).push({
          score: m.score,
          venue: 'home',
          opponent: m.awayTeam,
          opponentRaw: m.awayTeamRaw,
          date: m.date
        });
        teamData.get(m.awayTeam).push({
          score: `${m.awayGoals}-${m.homeGoals}`,
          venue: 'away',
          opponent: m.homeTeam,
          opponentRaw: m.homeTeamRaw,
          date: m.date
        });
      }

      // Recalcul pour chaque équipe concernée
      const affectedTeams = new Set();
      for (const [teamName, matches] of teamData) {
        // Trier par date
        matches.sort((a, b) => new Date(a.date) - new Date(b.date));
        
        const existingTeam = await DB.getTeam(teamName);
        if (existingTeam) {
          // Fusionner et dédoublonner
          const existingMatches = existingTeam.allMatches || [];
          const mergedMatches = this._mergeMatchesDedup(existingMatches, matches);
          
          // Recalculer avec le nouveau moteur pondéré
          const computed = StatsCalculator.computeWeightedStats(mergedMatches, new Date());
          if (computed) {
            await DB.saveTeam({
              name: teamName,
              displayName: existingTeam.displayName || teamData.get(teamName)[0]?.opponentRaw || teamName,
              stats: computed.stats,
              homeStats: computed.homeStats,
              awayStats: computed.awayStats,
              last5: computed.last5,
              last10: computed.last10,
              last20: computed.last20,
              allMatches: mergedMatches.slice(0, 10000),
              seasonStats: computed.seasonStats,
              last365Stats: computed.last365Stats,
              totalMatches: computed.totalMatches,
              seasonMatches: computed.seasonMatches,
              last365Matches: computed.last365Matches,
              updatedAt: now(),
              version: (existingTeam.version || 0) + 1
            });
            updated++;
            newMatches += mergedMatches.length - (existingTeam.allMatches?.length || 0);
            affectedTeams.add(teamName);
          }
        } else {
          const computed = StatsCalculator.computeWeightedStats(matches, new Date());
          if (computed) {
            await DB.saveTeam({
              name: teamName,
              displayName: teamData.get(teamName)[0]?.opponentRaw || teamName,
              stats: computed.stats,
              homeStats: computed.homeStats,
              awayStats: computed.awayStats,
              last5: computed.last5,
              last10: computed.last10,
              last20: computed.last20,
              allMatches: matches.slice(0, 10000),
              seasonStats: computed.seasonStats,
              last365Stats: computed.last365Stats,
              totalMatches: computed.totalMatches,
              seasonMatches: computed.seasonMatches,
              last365Matches: computed.last365Matches,
              updatedAt: now(),
              version: 1
            });
            added++;
            newMatches += matches.length;
            affectedTeams.add(teamName);
          }
        }
      }

      // Vider le cache de stats pour les équipes affectées
      for (const team of affectedTeams) {
        await DB.saveStatsCache(`team_${team}_full`, null); // Invalider le cache
      }
      DB.clearCache();

      // Mettre à jour l'affichage
      App._teamsCache = await DB.getAllTeams();
      await App._updateCounts();

      // Recalculer le Home Advantage par ligue
      await App.recalculateHomeAdvantage();

      const duration = ((Date.now() - startTime) / 1000).toFixed(1);
      
      // Générer le rapport
      const reportHTML = `
        <div class="import-summary">
          <div class="line"><span>📁 Fichier</span><span style="color:var(--cyan)">${file.name}</span></div>
          <div class="line"><span>⏱️ Temps</span><span>${duration}s</span></div>
          <div class="line"><span>➕ Nouvelles équipes</span><span style="color:var(--green)">${added}</span></div>
          <div class="line"><span>🔄 Équipes mises à jour</span><span style="color:var(--yellow)">${updated}</span></div>
          <div class="line"><span>⚽ Nouveaux matchs</span><span style="color:var(--cyan)">${uniqueMatches.length}</span></div>
          <div class="line"><span>🗑️ Lignes ignorées</span><span style="color:var(--sub)">${skipped}</span></div>
          <div class="line" style="border-top:1px solid var(--border);padding-top:4px"><span>📊 Total matchs base</span><span style="color:var(--green);font-weight:700">${App._teamsCache.reduce((s,t)=>s+(t.allMatches?.length||0),0)}</span></div>
          <div class="line"><span>🗄️ Total équipes</span><span style="color:var(--green);font-weight:700">${App._teamsCache.length}</span></div>
          ${errors.length > 0 ? `<div class="section-title" style="color:var(--red)">⚠️ Erreurs (${errors.length})</div><div class="error-report">${errors.slice(0, 20).map(e => `<div>• ${e}</div>`).join('')}${errors.length > 20 ? `<div>... et ${errors.length - 20} autres</div>` : ''}</div>` : ''}
        </div>`;

      st.innerHTML = reportHTML;

      // Ajouter au journal d'importation
      const importLogEntry = {
        date: now(),
        fileName: file.name,
        totalLines: lines.length - 1,
        matchesImported: uniqueMatches.length,
        newTeams: added,
        updatedTeams: updated,
        skippedLines: skipped,
        errors: errors.slice(0, 10),
        duration: parseFloat(duration),
        timestamp: Date.now()
      };
      await DB.addImportLog(importLogEntry);
      await App.showImportLog();

      return { added, updated, newMatches, errors };
    } catch (e) {
      st.innerHTML = `❌ Erreur critique: ${e.message}`;
      console.error(e);
      return { added: 0, updated: 0, newMatches: 0, errors: [e.message] };
    }
  },

  _detectColumnsAdvanced(headers) {
    const result = {
      dateCol: -1,
      homeTeam: -1,
      awayTeam: -1,
      homeGoals: -1,
      awayGoals: -1,
      scoreCol: -1
    };

    // Détection date
    result.dateCol = DateParser.detectColumn(headers);

    const lowerHeaders = headers.map((h, i) => ({ index: i, name: h.toLowerCase().trim().replace(/[^a-z0-9]/g, '') }));
    
    // Colonnes équipe
    const homeKeywords = ['hometeam', 'home_team', 'team_a', 'home', 'equipedomicile', 'local'];
    const awayKeywords = ['awayteam', 'away_team', 'team_b', 'away', 'equipeexterieur', 'visitor'];
    
    for (const h of lowerHeaders) {
      if (result.homeTeam === -1 && homeKeywords.some(k => h.name.includes(k) || h.name === k)) result.homeTeam = h.index;
      if (result.awayTeam === -1 && awayKeywords.some(k => h.name.includes(k) || h.name === k)) result.awayTeam = h.index;
    }

    // Colonnes buts
    const hgKeywords = ['fthg', 'home_goals', 'hg', 'home_score', 'butsdomicile', 'homegoals'];
    const agKeywords = ['ftag', 'away_goals', 'ag', 'away_score', 'butsexterieur', 'awaygoals'];
    const scoreKeywords = ['score', 'result', 'resultat', 'final_score', 'fulltime'];

    for (const h of lowerHeaders) {
      if (result.homeGoals === -1 && hgKeywords.some(k => h.name.includes(k) || h.name === k)) result.homeGoals = h.index;
      if (result.awayGoals === -1 && agKeywords.some(k => h.name.includes(k) || h.name === k)) result.awayGoals = h.index;
      if (result.scoreCol === -1 && scoreKeywords.some(k => h.name.includes(k) || h.name === k)) result.scoreCol = h.index;
    }

    // Fallback automatique
    if (result.homeTeam === -1 && headers.length >= 4) result.homeTeam = 0;
    if (result.awayTeam === -1 && headers.length >= 4) result.awayTeam = 1;
    if (result.homeGoals === -1 && headers.length >= 4) result.homeGoals = 2;
    if (result.awayGoals === -1 && headers.length >= 4) result.awayGoals = 3;

    return result;
  },

  _mergeMatchesDedup(existing, newMatches) {
    const seen = new Set(existing.map(m => `${m.opponent}_${m.score}_${m.venue}_${m.date || 'nodate'}`));
    const toAdd = newMatches.filter(m => {
      const key = `${m.opponent}_${m.score}_${m.venue}_${m.date || 'nodate'}`;
      if (!seen.has(key)) { seen.add(key); return true; }
      return false;
    });
    return [...existing, ...toAdd].sort((a, b) => new Date(a.date || '1970-01-01') - new Date(b.date || '1970-01-01'));
  }
};

